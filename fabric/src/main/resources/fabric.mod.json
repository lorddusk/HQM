{
  "schemaVersion": 1,
  "id": "hardcorequesting",
  "version": "${version}",
  "name": "Hardcore Questing Mode",
  "description": "This mod will add Hardcore mode with extra lives. If you use up your lives, your world will be deleted or you will be banned.",
  "authors": [
    "Vswe",
    "Lorddusk",
    "Newcastlegeek",
    "Way2muchnoise",
    "McJty",
    "canitzp",
    "ArclightTW",
    "shedaniel",
    "kirderf1",
    "CodexAdrian"
  ],
  "contact": {
    "sources": "https://github.com/shedaniel/HQM",
    "issues": "https://github.com/shedaniel/HQM/issues"
  },
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "hardcorequesting.fabric.HardcoreQuestingFabric"
    ],
    "fabric-gametest": [
      "hardcorequesting.fabric.HQMTest",
      "hardcorequesting.fabric.test.PersistenceTests",
      "hardcorequesting.fabric.test.QuestLogicTests",
      "hardcorequesting.fabric.test.TaskCompletionTests",
      "hardcorequesting.fabric.test.TeamTests",
      "hardcorequesting.fabric.test.LivesTests",
      "hardcorequesting.fabric.test.RewardTests",
      "hardcorequesting.fabric.test.CommandTests",
      "hardcorequesting.fabric.test.NetworkTests"
    ],
    "cardinal-components": [
      "hardcorequesting.fabric.capabilities.ModCapabilities"
    ]
  },
  "mixins": [
    "hardcorequesting.mixins.json"
  ],
  "accessWidener": "hqm.accesswidener",
  "depends": {
    "fabricloader": ">=0.16",
    "fabric": ">=0.116",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "architectury": ">=13",
    "cardinal-components-base": ">=6",
    "cardinal-components-entity": ">=6"
  },
  "custom": {
    "cardinal-components": [
      "hardcorequesting:player_extra_data"
    ]
  }
}
